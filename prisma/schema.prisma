// OCare Phinas — Prisma schema (Phase 3 foundation)
// Mirrors ocare-phinas-payment-flow.md §9 + additions (§14.4 plan_payments,
// §15.5 admin_users/admin_permissions). Money is stored in whole naira (Int).
// Enum values match the app's TypeScript string unions so the API can return
// them directly (see src/lib/*.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums (lowercase to match the frontend string unions)
// ----------------------------------------------------------------------------

enum Condition {
  new
  used
}

enum PlanType {
  outright
  solo
  group
}

enum PlanFrequency {
  daily
  weekly
  monthly
}

enum PlanStatus {
  active
  processing
  delivered
  completed
  awaiting_substitution
}

enum OrderStatus {
  pending_payment
  payment_submitted
  in_plan
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum GroupStatus {
  open
  closed
  completed
}

enum DeliveryMethod {
  delivery
  pickup
}

enum TxnType {
  deposit
  allocation
  delivery_deduction
  surplus_return
}

enum NotificationChannel {
  sms
  in_app
}

enum AdminRole {
  super
  sub
}

enum AdminPermission {
  dashboard
  products
  categories
  orders
  customers
  groups
  arrears
  settings
  team
}

// ----------------------------------------------------------------------------
// Customers, wallet, auth
// ----------------------------------------------------------------------------

model Customer {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String   @unique
  passwordHash  String
  phoneVerified Boolean  @default(false)
  blocked       Boolean  @default(false)
  createdAt     DateTime @default(now())

  wallet        Wallet?
  plans         Plan[]
  orders        Order[]
  memberships   GroupMembership[]
  notifications Notification[]
}

model Wallet {
  id               String   @id @default(cuid())
  customerId       String   @unique
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Total = everything paid in not yet consumed by a delivered product.
  totalBalance     Int      @default(0)
  // Available = uncommitted (allocations are derived from active plans).
  availableBalance Int      @default(0)
  spentOnProducts  Int      @default(0)
  transactions     Transaction[]
}

/// One-time phone codes (registration / login verification). Provider-agnostic;
/// Phase 3 wires a real SMS gateway in the send endpoint.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("verify")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  logo     String?
  products Product[]
}

model Product {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  price         Int
  stockQuantity Int       @default(0)
  condition     Condition @default(new)
  images        String[]
  specs         Json?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id])

  plans      Plan[]
  orderItems OrderItem[]
}

// ----------------------------------------------------------------------------
// Pay Small Small: groups & plans
// ----------------------------------------------------------------------------

model Group {
  id              String      @id @default(cuid())
  reference       String      @unique
  name            String
  totalSlots      Int         @default(10)
  slotsFilled     Int         @default(0)
  cycleLengthDays Int         @default(50)
  status          GroupStatus @default(open)
  createdAt       DateTime    @default(now())

  memberships GroupMembership[]
  plans       Plan[]
}

model GroupMembership {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  position    Int
  slotsHeld   Int      @default(1)
  cycleNumber Int      @default(1)

  @@unique([groupId, position])
}

/// A purchase the customer is paying toward. Outright = paid once; Solo/Group =
/// a payment schedule confirmed period-by-period by an admin (payment-flow §14).
model Plan {
  id                String         @id @default(cuid())
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type              PlanType
  productId         String?
  product           Product?       @relation(fields: [productId], references: [id])
  productPrice      Int
  // Delivery fee folded into the plan: the schedule collects productPrice +
  // deliveryFee. 0 for pickup. Fulfilment thresholds still key off productPrice.
  deliveryFee       Int            @default(0)
  slots             Int            @default(1)
  perPayment        Int
  frequency         PlanFrequency  @default(daily)
  startDate         DateTime
  amountAllocated   Int            @default(0)
  status            PlanStatus     @default(active)
  groupId           String?
  group             Group?         @relation(fields: [groupId], references: [id])
  originalProductId String?
  createdAt         DateTime       @default(now())

  order        Order?
  payments     PlanPayment[]
  transactions Transaction[]
}

// ----------------------------------------------------------------------------
// Orders & payments
// ----------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  reference   String      @unique
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  status         OrderStatus    @default(pending_payment)
  paymentPlan    PlanType       @default(outright)
  deliveryMethod DeliveryMethod @default(delivery)
  subtotal       Int
  deliveryFee    Int            @default(0)
  total          Int

  shipAddress  String
  shipCity     String
  shipState    String
  shipLandmark String?

  // Present for Solo / Group orders — the schedule lives on the linked Plan.
  planId String? @unique
  plan   Plan?   @relation(fields: [planId], references: [id])

  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?  @relation(fields: [productId], references: [id])
  name      String
  brand     String?
  condition Condition @default(new)
  price     Int
  qty       Int       @default(1)
  image     String?
}

/// Per-period manual confirmation for a Solo / Group plan. Idempotent on
/// (planId, periodIndex). amountAllocated for a plan = sum of these.
model PlanPayment {
  id            String     @id @default(cuid())
  planId        String
  plan          Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  periodIndex   Int
  amount        Int
  dueDate       DateTime
  confirmedAt   DateTime   @default(now())
  confirmedById String?
  confirmedBy   AdminUser? @relation(fields: [confirmedById], references: [id])

  @@unique([planId, periodIndex])
}

/// Every money movement. NOTE: there is no withdrawal type — money only ever
/// becomes a product.
model Transaction {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      TxnType
  amount    Int
  planId    String?
  plan      Plan?    @relation(fields: [planId], references: [id])
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Notification {
  id         String              @id @default(cuid())
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    NotificationChannel
  type       String
  planId     String?
  body       String
  sentAt     DateTime?
  createdAt  DateTime            @default(now())
}

// ----------------------------------------------------------------------------
// Admins (super + sub) and permissions
// ----------------------------------------------------------------------------

model AdminUser {
  id                 String                  @id @default(cuid())
  name               String
  email              String                  @unique
  passwordHash       String
  role               AdminRole               @default(sub)
  mustChangePassword Boolean                 @default(true)
  disabled           Boolean                 @default(false)
  createdById        String?
  createdBy          AdminUser?              @relation("AdminCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime                @default(now())

  created     AdminUser[]            @relation("AdminCreatedBy")
  permissions AdminPermissionGrant[]
  confirmed   PlanPayment[]
}

model AdminPermissionGrant {
  id          String          @id @default(cuid())
  adminUserId String
  adminUser   AdminUser       @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  permission  AdminPermission

  @@unique([adminUserId, permission])
}

// ----------------------------------------------------------------------------
// Store settings (singleton)
// ----------------------------------------------------------------------------

model Settings {
  id                String @id @default("singleton")
  storeName         String @default("OCare Phinas")
  bankName          String @default("")
  bankAccountName   String @default("")
  bankAccountNumber String @default("")
  whatsappNumber    String @default("")
  deliveryFee       Int    @default(2500)
  // Pay Small Small defaults (slot engine is fixed business logic).
  slotDaily         Int    @default(1000)
  cycleDays         Int    @default(50)
  groupSlots        Int    @default(10)
  groupPriceCap     Int    @default(100000)
}
